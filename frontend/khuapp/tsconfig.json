{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "baseUrl": "./",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/components/*": [
        "src/components/*"
      ],
      "@/hooks/*": [
        "src/hooks/*"
      ],
      "@/common/*": [
        "src/components/ui/common/*"
      ],
      "@/constants/*": [
        "src/constants/*"
      ],      
      "@/layout/*": [
        "src/components/ui/layout/*"
      ],
      "@/navigation/*": [
        "src/components/ui/navigation/*"
      ]
    }
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx"
  ]
}
