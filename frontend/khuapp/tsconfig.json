{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./*"],  // 모든 경로를 src 하위에서 찾음
      "@/components/*": ["components/*"],
      "@/hooks/*": ["hooks/*"],
      "@/common/*": ["components/ui/common/*"]
    }
  },
  "include": [
    "./**/*.ts",  // src 안에서 모든 TS 파일 탐색
    "./**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}


